# Port for FastAPI microservice
PORT=8000

# Neo4j Graph Database Configuration
# Connect to your local Neo4j Desktop / Docker or Neo4j Aura cloud instance:
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cyclecare123

# Note: If Neo4j is not running, the microservice automatically runs
# on its built-in in-memory knowledge graph with zero configuration required!

